.auth-section {
  min-height: calc(100vh - 140px);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  box-sizing: border-box;

  padding: 55px 20px 70px;

  background:
    radial-gradient(
      circle at 15% 20%,
      rgba(34, 211, 238, 0.08),
      transparent 30%
    ),
    radial-gradient(
      circle at 85% 80%,
      rgba(20, 184, 166, 0.06),
      transparent 30%
    ),
    #f7f9fc;
}

.auth-container {
  width: 100%;
  max-width: 500px;
}

.auth-card {
  width: 100%;
  box-sizing: border-box;
  padding: 40px;
  border: 1px solid #e5e7eb;
  border-radius: 20px;
  background: #ffffff;
  box-shadow:
    0 25px 70px rgba(15, 23, 42, 0.08),
    0 4px 12px rgba(15, 23, 42, 0.03);
}

.auth-header {
  margin-bottom: 30px;
}

.auth-icon {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18px;
  border-radius: 13px;
  background: #ecfeff;
  color: #0891b2;
  font-size: 19px;
}

.auth-header h1 {
  margin: 0 0 9px;
  color: #0f172a;
  font-size: 30px;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: -0.8px;
}

.auth-header p {
  margin: 0;
  color: #64748b;
  font-size: 14px;
  line-height: 1.6;
}

/* Form */

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.input-group label {
  color: #334155;
  font-size: 13px;
  font-weight: 650;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label-row a {
  color: #0891b2;
  font-size: 12px;
  font-weight: 600;
  text-decoration: none;
}

.label-row a:hover {
  text-decoration: underline;
}

.input-wrapper {
  position: relative;
}

.input-icon {
  position: absolute;
  top: 50%;
  left: 16px;
  transform: translateY(-50%);
  color: #94a3b8;
  pointer-events: none;
}

.input-wrapper input {
  width: 100%;
  height: 50px;
  box-sizing: border-box;
  padding: 0 48px;
  border: 1px solid #dbe2ea;
  border-radius: 10px;
  outline: none;
  background: #ffffff;
  color: #0f172a;
  font-size: 14px;
  transition: 0.2s ease;
}

.input-wrapper input::placeholder {
  color: #a8b2c1;
}

.input-wrapper input:hover {
  border-color: #cbd5e1;
}

.input-wrapper input:focus {
  border-color: #22b8d0;
  box-shadow: 0 0 0 4px rgba(34, 184, 208, 0.1);
}

.password-toggle {
  position: absolute;
  top: 50%;
  right: 13px;
  transform: translateY(-50%);
  border: none;
  background: transparent;
  color: #0891b2;
  cursor: pointer;
  font-size: 12px;
  font-weight: 600;
}

.password-hint {
  color: #94a3b8;
  font-size: 11px;
}

/* Button */

.auth-button {
  width: 100%;
  height: 51px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-top: 3px;
  border: none;
  border-radius: 10px;
  background: linear-gradient(135deg, #06b6d4, #0891b2);
  color: #ffffff;
  cursor: pointer;
  font-size: 14px;
  font-weight: 700;
  box-shadow: 0 8px 20px rgba(8, 145, 178, 0.18);
  transition: 0.2s ease;
}

.auth-button:hover {
  transform: translateY(-1px);
  box-shadow: 0 12px 25px rgba(8, 145, 178, 0.25);
}

.auth-button span {
  font-size: 18px;
}

/* Divider */

.auth-divider {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 27px 0 18px;
  color: #94a3b8;
  font-size: 11px;
}

.auth-divider::before,
.auth-divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: #e5e7eb;
}

/* Github */

.social-button {
  width: 100%;
  height: 49px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border: 1px solid #dbe2ea;
  border-radius: 10px;
  background: #ffffff;
  color: #334155;
  cursor: pointer;
  font-size: 13px;
  font-weight: 650;
  transition: 0.2s ease;
}

.social-button:hover {
  background: #f8fafc;
  border-color: #cbd5e1;
}

/* Bottom */

.auth-switch {
  margin: 25px 0 0;
  color: #64748b;
  text-align: center;
  font-size: 13px;
}

.auth-switch a {
  margin-left: 5px;
  color: #0891b2;
  font-weight: 700;
  text-decoration: none;
}

.auth-switch a:hover {
  text-decoration: underline;
}

.auth-security {
  margin: 24px 0 0;
  color: #94a3b8;
  text-align: center;
  font-size: 10px;
}

.auth-security i {
  margin-right: 5px;
}

/* Responsive */

@media (max-width: 600px) {
  .auth-section {
    min-height: calc(100vh - 120px);
    padding: 30px 15px;
  }

  .auth-card {
    padding: 30px 22px;
    border-radius: 16px;
  }

  .auth-header h1 {
    font-size: 26px;
  }
}

@media (max-width: 400px) {
  .auth-card {
    padding: 25px 18px;
    box-shadow: none;
  }

  .auth-section {
    padding: 20px 10px;
  }
}

/* =========================================
   SIGNUP PAGE FIX
   ========================================= */

.signup-auth-section {
  min-height: auto;
  box-sizing: border-box;

  display: flex;
  align-items: flex-start;
  justify-content: center;

  padding: 55px 20px 70px;
}

.signup-auth-section .auth-container {
  width: 100%;
  max-width: 500px !important;
  margin-left: auto;
  margin-right: auto;
}

.signup-auth-section .signup-auth-card {
  width: 100% !important;
  max-width: 500px !important;
  box-sizing: border-box;

  margin-left: auto;
  margin-right: auto;
}

/* Make signup slightly more compact */

.signup-auth-section .auth-header {
  margin-bottom: 26px;
}

.signup-auth-section .auth-form {
  gap: 17px;
}

.signup-auth-section .auth-button {
  margin-top: 2px;
}

.signup-auth-section .auth-divider {
  margin-top: 22px;
  margin-bottom: 16px;
}

.signup-auth-section .auth-switch {
  margin-top: 22px;
}

.signup-auth-section .auth-security {
  margin-top: 20px;
}

/* =========================================
   MOBILE
   ========================================= */

@media (max-width: 600px) {
  .signup-auth-section {
    padding: 30px 15px 50px;
  }

  .signup-auth-section .auth-container,
  .signup-auth-section .signup-auth-card {
    width: 100% !important;
    max-width: 500px !important;
  }
}
